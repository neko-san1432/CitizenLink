# ============================================================
# CitizenLink / DRIMS — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=3000
HOST=localhost

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Security ---
CSRF_SECRET=generate-a-random-32-byte-hex-string
PRODUCTION_URL=https://your-production-domain.com

# --- CAPTCHA (Google reCAPTCHA v2) ---
CAPTCHA_CLIENT_KEY=your-recaptcha-site-key
CAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# --- Feature Flags ---
ENABLE_LEGACY_ROLES=false
DISABLE_RATE_LIMITING=false

# --- Proxy ---
TRUST_PROXY=false

# --- Dev Test Accounts (For Quick Login in Development) ---
# These are used for one-click login testing without typing credentials
# Only works when NODE_ENV=development
DEV_CITIZEN_EMAIL=your_citizen_test_email@test.com
DEV_CITIZEN_PASSWORD=your_citizen_password
DEV_LGU_EMAIL=your_lgu_test_email@test.com
DEV_LGU_PASSWORD=your_lgu_password
DEV_SUPERADMIN_EMAIL=your_admin_test_email@test.com
DEV_SUPERADMIN_PASSWORD=your_admin_password
